# Variables del clúster de 3 brokers en EC2 (compose.cluster.yml).
# Copiar a ".env" en esta misma carpeta y ajustar. El archivo .env no se sube al repo.

# IP pública (Elastic IP) de la instancia: es la dirección que Kafka anuncia a los clientes.
KAFKA_HOST=184.192.63.192

# Mismos puertos que ya usan los servicios (bootstrap 184.192.63.192:9092); los otros dos
# brokers escuchan en 9093 y 9094. Los tres deben estar abiertos en el Security Group.
KAFKA_PORT_1=9092
KAFKA_PORT_2=9093
KAFKA_PORT_3=9094

# Memoria de cada JVM (3 brokers + 3 Zookeeper). Ajustar según el tamaño de la instancia:
#   ~4 GB de RAM (3,8 GB útiles) -> valores de abajo; en total el clúster usa ~2,6 GB
#   2 GB de RAM -> no alcanza para el clúster completo
BROKER_HEAP=-Xmx320m -Xms160m
ZK_HEAP=-Xmx128m -Xms64m
UI_HEAP=-Xmx256m

# Token de la API kafka-admin (obligatorio en un servidor)
KAFKA_ADMIN_TOKEN=cambiar-este-valor
